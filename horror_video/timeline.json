     "end": 776.564
    }
   ]
  },
  {
   "shot": 157,
   "sentences": [
    {
     "text": "After dinner, Diane brings out the photo albums.",
     "start": 777.19,
     "end": 779.736
    }
   ]
  },
  {
   "shot": 158,
   "sentences": [
    {
     "text": "\"This is Lily's first birthday,\" she says.",
     "start": 780.531,
     "end": 782.908
    },
    {
     "text": "Baby Lily, cake all over her face.",
     "start": 783.816,
     "end": 785.929
    }
   ]
  },
  {
   "shot": 159,
   "sentences": [
    {
     "text": "\"Lily at Disney World.\"",
     "start": 786.847,
     "end": 787.886
    },
    {
     "text": "Mickey ears.",
     "start": 788.674,
     "end": 789.261
    }
   ]
  },
  {
   "shot": 160,
   "sentences": [
    {
     "text": "\"Lily's first day of kindergarten.\"",
     "start": 790.144,
     "end": 791.74
    },
    {
     "text": "\"Lily on the swing set Frank built.\"",
     "start": 792.575,
     "end": 794.188
    }
   ]
  },
  {
   "shot": 161,
   "sentences": [
    {
     "text": "Lily.",
     "start": 795.024,
     "end": 795.423
    },
    {
     "text": "Lily.",
     "start": 796.003,
     "end": 796.323
    },
    {
     "text": "Lily.",
     "start": 797.075,
     "end": 797.349
    }
   ]
  },
  {
   "shot": 162,
   "sentences": [
    {
     "text": "There's only one little girl.",
     "start": 798.452,
     "end": 799.701
    }
   ]
  },
  {
   "shot": 163,
   "sentences": [
    {
     "text": "You pull the old Polaroid out of your wallet.",
     "start": 800.656,
     "end": 802.546
    },
    {
     "text": "You've looked at it every night for two weeks.",
     "start": 803.413,
     "end": 805.286
    }
   ]
  },
  {
   "shot": 164,
   "sentences": [
    {
     "text": "Two girls on a swing set.",
     "start": 806.217,
     "end": 807.394
    },
    {
     "text": "Yellow dresses.",
     "start": 808.145,
     "end": 808.812
    }
   ]
  },
  {
   "shot": 165,
   "sentences": [
    {
     "text": "The girl on the right is Lily.",
     "start": 809.804,
     "end": 810.861
    },
    {
     "text": "Smiling.",
     "start": 811.492,
     "end": 811.89
    },
    {
     "text": "Perfectly clear.",
