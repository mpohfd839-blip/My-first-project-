     "end": 64.901
    }
   ]
  },
  {
   "shot": 13,
   "sentences": [
    {
     "text": "Mrs. Whitmore is beautiful.",
     "start": 66.065,
     "end": 67.465
    },
    {
     "text": "Blonde hair pinned up.",
