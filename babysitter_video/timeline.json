   ]
  },
  {
   "shot": 23,
   "sentences": [
    {
     "text": "On the wall by the stairs, there are photos of a big black Labrador.",
     "start": 127.711,
     "end": 130.548
    }
   ]
  },
  {
   "shot": 24,
   "sentences": [
    {
     "text": "\"Oh, that's Pepper,\" Claire says.",
     "start": 131.507,
     "end": 133.223
    },
    {
     "text": "\"She's at the kennel this weekend.",
     "start": 133.683,
     "end": 134.884
    },
    {
     "text": "She doesn't do well with strangers.\"",
     "start": 135.297,
     "end": 136.486
    }
   ]
  },
  {
   "shot": 25,
   "sentences": [
    {
     "text": "Then she walks you into the kitchen, and you see the note.",
     "start": 137.478,
     "end": 140.328
    }
   ]
  },
  {
   "shot": 26,
   "sentences": [
    {
     "text": "It's taped to the fridge, right at eye level.",
     "start": 141.379,
     "end": 143.807
    },
    {
     "text": "Rules for tonight.",
     "start": 145.02,
     "end": 146.238
