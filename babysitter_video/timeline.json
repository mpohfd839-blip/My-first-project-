  },
  {
   "shot": 2,
   "sentences": [
    {
     "text": "The mother tells you not to worry about them.",
     "start": 8.716,
     "end": 11.876
    },
    {
     "text": "\"It's an old house,\" she says.",
     "start": 12.107,
     "end": 13.502
    },
    {
     "text": "\"Just humor us.\"",
     "start": 15.053,
     "end": 15.92
