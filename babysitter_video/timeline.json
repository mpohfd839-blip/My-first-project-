     "end": 35.802
    },
    {
     "text": "One night.",
     "start": 36.9,
     "end": 37.295
    },
    {
     "text": "One baby.",
     "start": 37.944,
     "end": 38.473
    },
    {
     "text": "Four hundred dollars.",
     "start": 39.075,
     "end": 39.938
    }
   ]
  },
  {
   "shot": 7,
   "sentences": [
    {
     "text": "The family's name is Whitmore.",
     "start": 41.099,
     "end": 42.396
    },
    {
     "text": "The address is the last house on a dead-end road outside of town, where the streetlights stop and the trees start.",
