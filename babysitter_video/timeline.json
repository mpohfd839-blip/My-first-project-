  },
  {
   "shot": 28,
   "sentences": [
    {
     "text": "Rule number two.",
     "start": 152.394,
     "end": 153.369
    },
    {
     "text": "The baby does not have a twin.",
     "start": 154.685,
     "end": 157.301
    },
    {
     "text": "If you see two, put the one in the crib back in the closet.",
     "start": 158.106,
     "end": 161.407
    }
