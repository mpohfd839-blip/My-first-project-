  {
   "shot": 27,
   "sentences": [
    {
     "text": "Rule number one.",
     "start": 147.511,
     "end": 148.209
    },
    {
     "text": "Do not go upstairs after 10 PM, even if the baby cries.",
     "start": 149.292,
     "end": 151.673
