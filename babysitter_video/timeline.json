   ]
  },
  {
   "shot": 22,
   "sentences": [
    {
     "text": "\"We sleep upstairs,\" Claire says.",
     "start": 121.28,
     "end": 123.091
    },
    {
     "text": "\"But Noah stays down here.",
     "start": 123.64,
     "end": 124.726
