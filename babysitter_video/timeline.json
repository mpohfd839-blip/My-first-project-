   ]
  },
  {
   "shot": 3,
   "sentences": [
    {
     "text": "By three in the morning, you'll understand that the rules were never meant to protect the baby.",
     "start": 16.277,
     "end": 18.871
    }
   ]
  },
  {
   "shot": 4,
   "sentences": [
    {
     "text": "They were meant to protect you.",
     "start": 19.91,
     "end": 20.854
    }
   ]
  },
  {
   "shot": 5,
   "sentences": [
    {
     "text": "You're twenty years old, and you need money.",
     "start": 22.87,
     "end": 25.044
    },
    {
     "text": "Rent is due on the first.",
     "start": 26.062,
     "end": 27.295
    },
    {
     "text": "Your car is making a noise you can't afford to fix.",
     "start": 28.074,
     "end": 30.91
    }
   ]
  },
  {
   "shot": 6,
   "sentences": [
    {
     "text": "So when a babysitting request pops up on the app at 4 PM on a Friday, you don't think twice.",
